{
  "manifest_version": 3,
  "name": "unread-forever",
  "version": "1.0.0",
  "description": "在 B 站消息中心正常查看谁赞了你、谁回复了你，但不推进已读游标，红点保留。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.bilibili.com/*"],
      "js": ["core.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
